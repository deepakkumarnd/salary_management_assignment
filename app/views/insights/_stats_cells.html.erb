<%# locals: (stats:, currency:) %>
<td class="text-right tabular-nums"><%= money(stats.min, currency) %></td>
<td class="text-right tabular-nums"><%= money(stats.median, currency) %></td>
<td class="text-right tabular-nums"><%= money(stats.average, currency) %></td>
<td class="text-right tabular-nums"><%= money(stats.max, currency) %></td>
<td class="text-right tabular-nums"><%= money(stats.total, currency) %></td>
