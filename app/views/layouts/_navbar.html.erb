<nav class="navbar bg-base-100 shadow-sm px-4">
  <div class="flex-1 flex items-center gap-2">
    <%= link_to current_user.organization.name, authenticated_root_path, class: "btn btn-ghost text-lg" %>
    <% if current_user.organization.setup_completed? %>
      <ul class="menu menu-horizontal px-1">
        <li><%= link_to "Employees", employees_path, class: class_names("menu-active" => controller_name.in?(%w[employees salary_revisions salary_revision_voids salary_revision_corrections employment_ends])) %></li>
        <li><%= link_to "Pay policy", countries_path, class: class_names("menu-active" => controller_name.in?(%w[countries country_allowances pay_structures])) %></li>
        <li><%= link_to "Insights", insights_path, class: class_names("menu-active" => controller_name == "insights") %></li>
      </ul>
    <% end %>
  </div>
  <div class="flex-none">
    <details class="dropdown dropdown-end">
      <summary class="btn btn-ghost"><%= current_user.full_name %></summary>
      <ul class="menu dropdown-content bg-base-100 rounded-box z-10 mt-2 w-60 p-2 shadow">
        <li class="menu-title truncate"><%= current_user.email %></li>
        <li><%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "w-full text-left" %></li>
      </ul>
    </details>
  </div>
</nav>
