<% content_for :title, "Record salary revision · #{@employee.full_name} · Salary Management" %>

<div class="max-w-4xl mx-auto space-y-4">
  <%= render "employees/breadcrumbs", employee: @employee, current: "Record salary revision" %>
  <div class="card bg-base-100 shadow-sm">
    <div class="card-body gap-4">
      <h1 class="card-title text-2xl">Record salary revision</h1>
      <p class="text-base-content/70">
        For <%= @employee.full_name %> (<span class="font-mono"><%= @employee.employee_code %></span>). The current basic is
        pre-filled; change it to the new annual basic.
      </p>

      <%= form_with model: @revision, scope: :salary_revision, url: employee_salary_revisions_path(@employee), class: "space-y-5",
                    data: { controller: "pay-preview", pay_preview_url_value: preview_pay_structures_path } do |f| %>
        <%= render "components/error_summary", messages: @revision.errors[:base] %>
        <%= render "salary_revisions/fields", form: f, revision: @revision, employee: @employee,
                                               reasons: SalaryRevision::REASONS - [ "hire" ] %>
        <div class="card-actions justify-between items-center pt-2">
          <%= link_to "Cancel", employee_path(@employee), class: "btn btn-ghost" %>
          <%= f.submit "Record revision", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
