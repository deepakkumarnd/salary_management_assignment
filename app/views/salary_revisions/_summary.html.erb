<%# locals: (revision:, employee:) %>
<dl class="grid grid-cols-[10rem_1fr] gap-x-4 gap-y-1 rounded-box bg-base-200 p-4 text-sm">
  <dt class="font-semibold">Effective</dt>
  <dd><%= revision.effective_on.to_fs(:human) %></dd>
  <dt class="font-semibold">Basic</dt>
  <dd class="tabular-nums"><%= money(revision.basic_pay, employee.country.currency_code) %></dd>
  <dt class="font-semibold">Reason</dt>
  <dd><%= revision_reason_label(revision.reason) %></dd>
  <dt class="font-semibold">Entered by</dt>
  <dd><%= revision.created_by.full_name %>, <%= local_time(revision.created_at) %></dd>
</dl>
