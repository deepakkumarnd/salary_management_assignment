<% content_for :title, "#{@country.name} · Pay policy · Salary Management" %>
<% currency = @country.currency_code %>

<div class="space-y-6">
  <div>
    <div class="breadcrumbs text-sm">
      <ul>
        <li><%= link_to "Pay policy", countries_path %></li>
        <li><%= @country.name %></li>
      </ul>
    </div>
    <h1 class="text-2xl font-bold flex items-center gap-2">
      <%= @country.name %> <span class="badge badge-ghost font-mono"><%= currency %></span>
    </h1>
  </div>

  <section class="card bg-base-100 shadow-sm" aria-labelledby="country-allowances">
    <div class="card-body">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 id="country-allowances" class="card-title">Country allowances</h2>
          <p class="text-sm text-base-content/70">Paid to everyone in <%= @country.name %>, whatever their role, as a % of basic pay.</p>
        </div>
        <%= link_to "Add country allowance", new_country_allowance_path(@country), class: "btn btn-sm btn-primary" %>
      </div>

      <% if @allowances.any? %>
        <div class="overflow-x-auto">
          <table class="table">
            <thead><tr><th>Allowance</th><th class="text-right">% of basic</th><th></th></tr></thead>
            <tbody>
              <% @allowances.each do |allowance| %>
                <tr>
                  <td><%= allowance.name %></td>
                  <td class="text-right tabular-nums"><%= percent(allowance.percent_bp) %></td>
                  <td class="text-right whitespace-nowrap">
                    <%= link_to "Edit", edit_country_allowance_path(@country, allowance), class: "btn btn-ghost btn-xs" %>
                    <%= button_to "Delete", country_allowance_path(@country, allowance), method: :delete,
                                  class: "btn btn-ghost btn-xs text-error", form_class: "inline",
                                  data: { turbo_confirm: "Delete #{allowance.name}? It stops applying to everyone in #{@country.name}." } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-base-content/70">No country allowances. Everyone's gross pay starts from basic plus their role's allowances.</p>
      <% end %>
    </div>
  </section>

  <section class="card bg-base-100 shadow-sm" aria-labelledby="pay-structures">
    <div class="card-body">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <div>
          <h2 id="pay-structures" class="card-title">Pay structures</h2>
          <p class="text-sm text-base-content/70">
            One per job role. Gross and total target pay are shown at the default basic pay, with the country allowances above.
          </p>
        </div>
        <% if @roles_without_structure.any? %>
          <%= link_to "Add pay structure", new_pay_structure_path(country_id: @country.id), class: "btn btn-sm btn-primary" %>
        <% end %>
      </div>

      <% if @roles_without_structure.any? %>
        <div role="note" class="alert alert-info alert-soft">
          <span>
            No pay structure yet: <%= @roles_without_structure.to_sentence %>.
            People in these roles can't be added in <%= @country.name %> until their role has one.
          </span>
        </div>
      <% end %>

      <% if @structures.any? %>
        <div class="overflow-x-auto">
          <table class="table table-sm">
            <thead>
              <tr>
                <th>Job role</th>
                <th class="text-right">Default basic</th>
                <th>Role allowances</th>
                <th class="text-right">Gross</th>
                <th class="text-right">Variable</th>
                <th class="text-right">Total target</th>
                <th class="text-right">Overtime</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% @structures.each do |structure| %>
                <% pay = structure.breakdown_for(structure.default_basic_pay, country_allowances: @allowances) %>
                <tr>
                  <td class="font-semibold"><%= structure.job_role.name %></td>
                  <td class="text-right tabular-nums"><%= money(structure.default_basic_pay, currency) %></td>
                  <td>
                    <% structure.allowances.sort_by { it.name.downcase }.each do |allowance| %>
                      <span class="badge badge-outline badge-sm whitespace-nowrap"><%= allowance.name %> <%= percent(allowance.percent_bp, trim: true) %></span>
                    <% end %>
                  </td>
                  <td class="text-right tabular-nums"><%= money(pay.gross, currency) %></td>
                  <td class="text-right tabular-nums"><%= percent(structure.variable_pay_percent_bp) %></td>
                  <td class="text-right tabular-nums font-semibold"><%= money(pay.total_target, currency) %></td>
                  <td class="text-right tabular-nums">
                    <%= percent(structure.overtime_percent_bp) %>
                    <div class="text-xs text-base-content/60"><%= currency_unit(currency) %><%= format("%.2f", pay.overtime_hourly) %>/h</div>
                  </td>
                  <td class="text-right whitespace-nowrap">
                    <%= link_to "Edit", edit_pay_structure_path(structure), class: "btn btn-ghost btn-xs" %>
                    <%= button_to "Delete", pay_structure_path(structure), method: :delete,
                                  class: "btn btn-ghost btn-xs text-error", form_class: "inline",
                                  data: { turbo_confirm: "Delete the pay structure for #{structure.job_role.name} in #{@country.name}?" } %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    </div>
  </section>
</div>
