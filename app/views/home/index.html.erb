<% content_for :title, "Home · Salary Management" %>

<div class="card bg-base-100 shadow-sm max-w-2xl">
  <div class="card-body">
    <h1 class="card-title text-2xl">Welcome, <%= current_user.full_name %></h1>
    <p class="text-base-content/70">
      <%= current_user.organization.name %> is set up. Employees, insights and payroll exports will appear here as
      they are built.
    </p>
    <div class="card-actions">
      <%= link_to "Go to pay policy", countries_path, class: "btn btn-primary" %>
    </div>
  </div>
</div>
