<%= render layout: "onboarding/step", locals: {
      step: :countries, title: "Countries",
      intro: "The countries you employ people in. Pay is set and paid in each country's currency." } do %>
  <%= form_with model: @organization, url: onboarding_countries_path, method: :patch, class: "space-y-4" do |f| %>
    <%= render "components/error_summary",
               messages: @organization.errors.messages_for(:countries).map(&:upcase_first) + @organization.errors[:base] %>

    <%= hidden_field_tag "organization[country_ids][]", "", id: nil %>
    <div class="grid sm:grid-cols-2 gap-3">
      <% Country.order(:name).each do |country| %>
        <label class="flex items-center gap-3 rounded-box border border-base-300 p-3 cursor-pointer hover:bg-base-200">
          <%= check_box_tag "organization[country_ids][]", country.id, @selected_ids.include?(country.id),
                            id: "country_#{country.id}", class: "checkbox checkbox-primary" %>
          <span class="flex-1"><%= country.name %></span>
          <span class="badge badge-ghost font-mono"><%= country.currency_code %></span>
        </label>
      <% end %>
    </div>

    <%= render "onboarding/actions", form: f, back: edit_onboarding_organization_path %>
  <% end %>
<% end %>
