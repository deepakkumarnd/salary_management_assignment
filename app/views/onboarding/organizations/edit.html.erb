<%= render layout: "onboarding/step", locals: {
      step: :organization, title: "Organization",
      intro: "Your organization's name, how employee IDs look, and the working week used for overtime rates." } do %>
  <%= form_with model: @organization, url: onboarding_organization_path, method: :patch, class: "space-y-4" do |f| %>
    <fieldset class="fieldset">
      <%= f.label :name, "Organization name", class: "fieldset-legend" %>
      <%= f.text_field :name, class: input_class(@organization, :name), required: true, maxlength: 100,
                              autocomplete: "organization" %>
      <%= field_errors(@organization, :name) %>
    </fieldset>

    <fieldset class="fieldset">
      <%= f.label :employee_code_prefix, "Employee ID prefix", class: "fieldset-legend" %>
      <%= f.text_field :employee_code_prefix, class: input_class(@organization, :employee_code_prefix, "input", "font-mono uppercase max-w-40"),
                                              maxlength: 6, placeholder: Organization.suggested_code_prefix(@organization.name),
                                              aria: { describedby: "prefix-hint" } %>
      <p id="prefix-hint" class="label text-wrap">
        2 to 6 letters. Employees get IDs like <span class="font-mono"><%= @organization.employee_code_prefix.presence || "ACME" %>-00001</span>.
        Leave blank to use a suggestion from the name.
      </p>
      <%= field_errors(@organization, :employee_code_prefix) %>
    </fieldset>

    <fieldset class="fieldset">
      <%= f.label :standard_hours_per_week, "Standard hours per week", class: "fieldset-legend" %>
      <%= f.number_field :standard_hours_per_week, in: 1..80, class: input_class(@organization, :standard_hours_per_week, "input", "max-w-40"),
                                                   aria: { describedby: "hours-hint" } %>
      <p id="hours-hint" class="label text-wrap">Used to work out hourly pay for overtime rates. Usually 40.</p>
      <%= field_errors(@organization, :standard_hours_per_week) %>
    </fieldset>

    <%= render "onboarding/actions", form: f %>
  <% end %>
<% end %>
