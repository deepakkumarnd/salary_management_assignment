<%# Centred card for the signed-out screens: render layout: "devise/shared/card", locals: { title: } do ... end %>
<% content_for :title, "#{title} · Salary Management" %>
<div class="min-h-[70vh] flex items-center justify-center">
  <div class="card bg-base-100 shadow-sm w-full max-w-md">
    <div class="card-body gap-4">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-base-content/60">Salary Management</p>
        <h1 class="text-2xl font-bold mt-1"><%= title %></h1>
      </div>
      <%= yield %>
    </div>
  </div>
</div>
