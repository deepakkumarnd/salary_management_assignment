<%= render layout: "devise/shared/card", locals: { title: "Forgot your password?" } do %>
  <p class="text-base-content/70 text-center">Enter your email and we'll send you a link to choose a new password.</p>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-2" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <fieldset class="fieldset">
      <%= f.label :email, class: "fieldset-legend" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input w-full" %>
    </fieldset>

    <%= f.submit "Send reset link", class: "btn btn-primary w-full" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
