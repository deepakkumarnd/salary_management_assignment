<%= render layout: "devise/shared/card", locals: { title: "Choose a password" } do %>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-2" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <fieldset class="fieldset">
      <%= f.label :password, "New password", class: "fieldset-legend" %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", required: true,
                                      minlength: @minimum_password_length, class: "input w-full" %>
      <% if @minimum_password_length %>
        <p class="label">At least <%= @minimum_password_length %> characters</p>
      <% end %>
    </fieldset>

    <fieldset class="fieldset">
      <%= f.label :password_confirmation, "Confirm new password", class: "fieldset-legend" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "input w-full" %>
    </fieldset>

    <%= f.submit "Save password", class: "btn btn-primary w-full" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
