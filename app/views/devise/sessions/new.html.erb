<%= render layout: "devise/shared/card", locals: { title: "Sign in" } do %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-2" }) do |f| %>
    <fieldset class="fieldset">
      <%= f.label :email, class: "fieldset-legend" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "input w-full" %>
    </fieldset>

    <fieldset class="fieldset">
      <%= f.label :password, class: "fieldset-legend" %>
      <%= f.password_field :password, autocomplete: "current-password", required: true, class: "input w-full" %>
    </fieldset>

    <%= f.submit "Sign in", class: "btn btn-primary w-full mt-4" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
